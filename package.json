{
  "name": "zotero-pdf-translate-plus-plus",
  "version": "2.4.10",
  "description": "Independently maintained Zotero translation plugin with reader popup math rendering and 20+ translation services.",
  "config": {
    "addonName": "Translate for Zotero++",
    "addonID": "zotero-pdf-translate-plus-plus@golden-pigeon",
    "addonRef": "zoteropdftranslateplusplus",
    "prefsPrefix": "extensions.zotero.ZoteroPDFTranslatePlusPlus",
    "addonInstance": "PDFTranslatePlusPlus"
  },
  "main": "src/index.ts",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "check:release": "node scripts/verify-release.mjs",
    "release": "zotero-plugin release",
    "lint": "prettier --write . && eslint . --fix",
    "test": "zotero-plugin test",
    "test:styles": "node --test scripts/scope-katex.test.mjs",
    "update-deps": "npm update --save"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Golden-Pigeon/zotero-pdf-translate-plus-plus.git"
  },
  "author": "Golden-Pigeon",
  "contributors": [
    {
      "name": "windingwind",
      "url": "https://github.com/windingwind"
    },
    {
      "name": "Upstream contributors",
      "url": "https://github.com/windingwind/zotero-pdf-translate/graphs/contributors"
    }
  ],
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/Golden-Pigeon/zotero-pdf-translate-plus-plus/issues"
  },
  "homepage": "https://github.com/Golden-Pigeon/zotero-pdf-translate-plus-plus#readme",
  "dependencies": {
    "franc": "^6.2.0",
    "iso639-js": "^1.1.3",
    "jsencrypt": "^3.5.0",
    "katex": "^0.16.25",
    "zotero-plugin-toolkit": "^5.1.0-beta.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.16.5",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.3"
  }
}
